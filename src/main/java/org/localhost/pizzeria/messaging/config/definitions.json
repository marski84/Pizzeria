{
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "users": [
    {
      "name": "guest",
      "password": "guest",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": "administrator"
    }
  ],
  "permissions": [
    {
      "user": "guest",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "queues": [
    {
      "name": "supply-check-queue",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "supply-check-dlq-exchange",
        "x-dead-letter-routing-key": "supply-check-dlq-routing-key",
        "x-message-ttl": 60000,
        "x-max-retries": 5
      }
    },
    {
      "name": "supply-check-dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
      }
    }
  ],
  "exchanges": [
    {
      "name": "supply-check-exchange",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "supply-check-dlq-exchange",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "supply-check-exchange",
      "vhost": "/",
      "destination": "supply-check-queue",
      "destination_type": "queue",
      "routing_key": "supply-check-routing-key",
      "arguments": {}
    },
    {
      "source": "supply-check-dlq-exchange",
      "vhost": "/",
      "destination": "supply-check-dlq",
      "destination_type": "queue",
      "routing_key": "supply-check-dlq-routing-key",
      "arguments": {}
    }
  ]
}